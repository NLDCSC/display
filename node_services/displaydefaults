# The names of the workers. This example create two workers
CELERYD_NODES="display_worker1 display_worker2"

# The name of the Celery App, should be the same as the python file
# where the Celery tasks are defined
CELERY_APP="display.celery_app.display_daemon"

# Log and PID directories
CELERYD_LOG_FILE="/opt/display/log/display_node.log"
CELERYD_PID_FILE="/opt/display/run/%n.pid"

# Log level
CELERYD_LOG_LEVEL=INFO

# Extra command-line arguments to the worker
CELERYD_OPTS=" -Q nodes -p gevent -c 20 -O fair --without-heartbeat --without-gossip --without-mingle"

# Path to celery binary, that is in your virtual environment
CELERY_BIN="/usr/local/bin/celery"
